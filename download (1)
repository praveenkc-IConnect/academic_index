import React, { useState } from 'react';
import { ResponsibilityReference } from '../types';
import { Plus, Trash, Settings, ShieldAlert, Sliders } from 'lucide-react';

interface ReferenceManagerProps {
  references: ResponsibilityReference[];
  weightFactor: number;
  onUpdateFactor: (factor: number) => Promise<void>;
  onAddReference: (ref: Omit<ResponsibilityReference, 'ref_id'>) => Promise<void>;
  onDeleteReference: (refId: number) => Promise<void>;
}

export const ReferenceManager: React.FC<ReferenceManagerProps> = ({
  references,
  weightFactor,
  onUpdateFactor,
  onAddReference,
  onDeleteReference
}) => {
  const [name, setName] = useState('');
  const [role, setRole] = useState('Placement Cell');
  const [type, setType] = useState<'Department' | 'Institute'>('Department');
  const [weight, setWeight] = useState(5);
  const [adding, setAdding] = useState(false);

  const [factorInput, setFactorInput] = useState(weightFactor);
  const [updatingFactor, setUpdatingFactor] = useState(false);
  const [successFactor, setSuccessFactor] = useState(false);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim()) return;
    setAdding(true);
    try {
      await onAddReference({
        type,
        responsibility_name: name,
        role_designation: role,
        score_weight: Number(weight)
      });
      setName('');
    } catch (err) {
      console.error(err);
    } finally {
      setAdding(false);
    }
  };

  const handleUpdateFactorSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setUpdatingFactor(true);
    setSuccessFactor(false);
    try {
      await onUpdateFactor(Number(factorInput));
      setSuccessFactor(true);
      setTimeout(() => setSuccessFactor(false), 3000);
    } catch (err) {
      console.error(err);
    } finally {
      setUpdatingFactor(false);
    }
  };

  const depts = references.filter(r => r.type === 'Department');
  const insts = references.filter(r => r.type === 'Institute');

  return (
    <div className="space-y-6">
      
      {/* 1. Academic Weight Factor Multipliers */}
      <div className="bg-white rounded-xl border border-slate-100 p-6 shadow-card transition-all">
        <div className="flex items-center gap-3 border-b border-slate-100 pb-4 mb-5">
          <div className="p-2.5 bg-rose-50 text-rose-600 rounded-lg">
            <Sliders className="w-5 h-5" />
          </div>
          <div>
            <h2 className="font-display font-semibold text-lg text-slate-900">Manage Institutional Weight Parameters</h2>
            <p className="text-xs text-slate-500">Alter coefficient formulas governing workloads and class hours calculations</p>
          </div>
        </div>

        <form onSubmit={handleUpdateFactorSubmit} className="max-w-md flex items-end gap-4">
          <div className="flex-grow">
            <label className="block text-xs font-mono font-medium text-slate-500 uppercase tracking-wider mb-2">
              Academic Workload Hours Weight Factor (0.1 to 2.0)
            </label>
            <input
              type="number"
              step="0.05"
              min="0.1"
              max="2"
              value={factorInput}
              onChange={(e) => setFactorInput(parseFloat(e.target.value) || 0)}
              className="w-full text-sm px-3.5 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-rose-500/10 focus:border-rose-500"
            />
          </div>
          <button
            type="submit"
            disabled={updatingFactor}
            className="px-4 py-2 border border-rose-600 bg-rose-600 hover:bg-rose-700 disabled:bg-rose-400 text-white rounded-lg text-xs font-semibold cursor-pointer whitespace-nowrap transition-colors"
          >
            {updatingFactor ? 'Saving...' : 'Apply Parameter'}
          </button>
        </form>
        {successFactor && (
          <div className="text-xs text-emerald-600 font-medium mt-2 bg-emerald-50 px-3 py-1.5 rounded border border-emerald-150">
            Workload coefficient parameter successfully applied onto the index calculation engine.
          </div>
        )}
      </div>

      {/* 2. Responsibility Weight Matrix Tables */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        {/* Create Form */}
        <div className="bg-white p-5 rounded-xl border border-slate-100 shadow-card h-fit">
          <h3 className="font-display font-semibold text-sm text-slate-900 border-b border-slate-100 pb-3 mb-4">
            Register Administrative Role Weight
          </h3>

          <form onSubmit={handleCreate} className="space-y-4 text-xs">
            <div>
              <label className="block text-slate-500 font-semibold mb-1">Administrative Type</label>
              <select
                value={type}
                onChange={(e) => setType(e.target.value as 'Department' | 'Institute')}
                className="w-full text-xs p-2 border border-slate-200 rounded focus:outline-none focus:border-rose-500 cursor-pointer"
              >
                <option value="Department">Departmental Role</option>
                <option value="Institute">Institutional Role</option>
              </select>
            </div>

            <div>
              <label className="block text-slate-500 font-semibold mb-1">Specific Designation Name</label>
              <input
                type="text"
                required
                value={name}
                onChange={(e) => setName(e.target.value)}
                placeholder="e.g. NBA Accreditation Coordinator, Warden..."
                className="w-full text-xs p-2 border border-slate-200 rounded focus:outline-none focus:border-rose-500"
              />
            </div>

            <div>
              <label className="block text-slate-500 font-semibold mb-1">Role Classification Tag</label>
              <input
                type="text"
                required
                value={role}
                onChange={(e) => setRole(e.target.value)}
                placeholder="e.g. Coordinator, Cell Lead..."
                className="w-full text-xs p-2 border border-slate-200 rounded focus:outline-none"
              />
            </div>

            <div>
              <label className="block text-slate-500 font-semibold mb-1">Weight Score points (1 to 10)</label>
              <input
                type="number"
                min="1"
                max="10"
                value={weight}
                onChange={(e) => setWeight(parseInt(e.target.value) || 1)}
                className="w-full text-xs p-2 border border-slate-200 rounded bg-white"
              />
            </div>

            <button
              type="submit"
              disabled={adding}
              className="w-full py-2 bg-slate-900 hover:bg-slate-800 disabled:bg-slate-400 text-white font-bold rounded cursor-pointer transition-colors"
            >
              Add Responsibility Rule
            </button>
          </form>
        </div>

        {/* List rules table */}
        <div className="lg:col-span-2 bg-white p-5 rounded-xl border border-slate-100 shadow-card space-y-6">
          <h3 className="font-display font-semibold text-sm text-slate-900 border-b border-slate-100 pb-3">
            Existing Registered Weight Rules Matrices
          </h3>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
            {/* Dept column rule list */}
            <div className="space-y-2">
              <div className="font-semibold text-slate-800 border-b pb-1 font-display text-xs">Department Rules ({depts.length})</div>
              <div className="space-y-1.5 max-h-[400px] overflow-y-auto pr-1">
                {depts.map((ref) => (
                  <div key={ref.ref_id} className="flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200/60 rounded">
                    <div className="overflow-hidden mr-2">
                      <div className="font-semibold text-slate-800 leading-tight truncate">{ref.responsibility_name}</div>
                      <div className="text-[9px] text-slate-400 font-medium">Tag: {ref.role_designation}</div>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className="font-bold bg-amber-50 text-amber-800 px-1.5 py-0.5 rounded border border-amber-100">+{ref.score_weight}</span>
                      <button
                        onClick={() => onDeleteReference(ref.ref_id)}
                        className="text-slate-400 hover:text-rose-600 transition-colors cursor-pointer"
                        title="Delete Rule"
                      >
                        <Trash className="w-3.5 h-3.5" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Institute column rule list */}
            <div className="space-y-2">
              <div className="font-semibold text-slate-800 border-b pb-1 font-display text-xs">Institutional Rules ({insts.length})</div>
              <div className="space-y-1.5 max-h-[400px] overflow-y-auto pr-1">
                {insts.map((ref) => (
                  <div key={ref.ref_id} className="flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200/60 rounded">
                    <div className="overflow-hidden mr-2">
                      <div className="font-semibold text-slate-800 leading-tight truncate">{ref.responsibility_name}</div>
                      <div className="text-[9px] text-slate-400 font-medium">Tag: {ref.role_designation}</div>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className="font-bold bg-amber-50 text-amber-800 px-1.5 py-0.5 rounded border border-amber-100">+{ref.score_weight}</span>
                      <button
                        onClick={() => onDeleteReference(ref.ref_id)}
                        className="text-slate-400 hover:text-rose-600 transition-colors cursor-pointer"
                        title="Delete Rule"
                      >
                        <Trash className="w-3.5 h-3.5" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  );
};
