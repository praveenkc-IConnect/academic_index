import React, { useState } from 'react';
import { EvaluationDetails, User } from '../types';
import { Printer, Check, X, ShieldAlert, Award, FileSpreadsheet, Lock, Sparkles, CheckCircle } from 'lucide-react';

interface ScoreSheetPrintProps {
  details: EvaluationDetails | null;
  activeUser: User | null;
  onSignOff: (role: 'HoD' | 'Dean' | 'Principal', comments: string, action: 'approve' | 'reject') => Promise<void>;
  onSubmitAppraisal: () => Promise<void>;
}

export const ScoreSheetPrint: React.FC<ScoreSheetPrintProps> = ({
  details,
  activeUser,
  onSignOff,
  onSubmitAppraisal
}) => {
  const [comments, setComments] = useState('');
  const [signing, setSigning] = useState(false);
  const [submitting, setSubmitting] = useState(false);

  if (!details) {
    return (
      <div className="bg-white p-6 rounded-xl border border-slate-100 text-center text-slate-500">
        No evaluation data initialized for this combination.
      </div>
    );
  }

  const {
    evaluation,
    faculty,
    academicYear,
    academicMetrics,
    researchMetrics,
    responsibilities,
    industrySocietalMetrics,
    calculatedScores
  } = details;

  const handlePrint = () => {
    window.print();
  };

  const handleSignOffAction = async (action: 'approve' | 'reject') => {
    if (!activeUser) return;
    const role = activeUser.role as 'HoD' | 'Dean' | 'Principal';
    setSigning(true);
    try {
      await onSignOff(role, comments, action);
      setComments('');
    } catch (err) {
      console.error(err);
    } finally {
      setSigning(false);
    }
  };

  const handleFacultySubmit = async () => {
    setSubmitting(true);
    try {
      await onSubmitAppraisal();
    } catch (err) {
      console.error(err);
    } finally {
      setSubmitting(false);
    }
  };

  // Determine authorities roles access actions
  const isAuthority = ['HoD', 'Dean', 'Principal'].includes(activeUser?.role || '');
  const activeRole = activeUser?.role as 'HoD' | 'Dean' | 'Principal';

  // Check if authority needs to sign
  let showSignOffForm = false;
  let authorityLocked = false;

  if (evaluation.is_submitted) {
    if (activeRole === 'HoD' && !evaluation.hod_signed) showSignOffForm = true;
    if (activeRole === 'Dean' && evaluation.hod_signed && !evaluation.dean_signed) showSignOffForm = true;
    if (activeRole === 'Principal' && evaluation.dean_signed && !evaluation.principal_signed) showSignOffForm = true;
  }

  // Visual highlights for ratings
  const getRatingColor = (rating: string) => {
    if (rating.includes('Excellent')) return 'text-emerald-700 bg-emerald-50 border-emerald-200';
    if (rating.includes('Very Good')) return 'text-sky-700 bg-sky-50 border-sky-200';
    if (rating.includes('Good')) return 'text-amber-700 bg-amber-50 border-amber-200';
    if (rating.includes('Satisfactory')) return 'text-indigo-700 bg-indigo-50 border-indigo-200';
    return 'text-rose-700 bg-rose-50 border-rose-200';
  };

  return (
    <div className="space-y-6">
      
      {/* 1. Quick Authority Audit Console (Forms shown only to HOD/Dean/Principal in session) */}
      {showSignOffForm && (
        <div className="bg-gradient-to-r from-amber-50 to-indigo-50 border border-indigo-200/60 rounded-xl p-5 shadow-card no-print space-y-4">
          <div className="flex items-start gap-3">
            <div className="p-2 bg-indigo-600 text-white rounded-lg">
              <Sparkles className="w-4.5 h-4.5" />
            </div>
            <div className="flex-grow">
              <h3 className="font-display font-semibold text-sm text-indigo-900">
                Evaluation Sign-Off Action (Role: <span className="font-mono bg-indigo-100 text-indigo-800 px-1.5 py-0.5 rounded font-bold">{activeRole}</span>)
              </h3>
              <p className="text-xs text-slate-500 mt-0.5">
                You are reviewing <strong>{faculty.name}</strong> ({faculty.department}) for Academic Year <strong>{academicYear.year_string}</strong>. Provide auditing remarks and approve or request revisions.
              </p>
            </div>
          </div>

          <div className="space-y-3">
            <textarea
              value={comments}
              onChange={(e) => setComments(e.target.value)}
              placeholder="Enter official sign-off comments, workload feedback, or research suggestions here..."
              className="w-full text-xs p-3 border border-indigo-250 bg-white rounded-lg focus:ring-2 focus:ring-indigo-500/20 resize-none h-20"
            />
            
            <div className="flex items-center justify-end gap-2.5">
              <button
                onClick={() => handleSignOffAction('reject')}
                disabled={signing}
                className="flex items-center gap-1.5 px-3.5 py-1.5 text-xs text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-250 rounded-lg font-semibold cursor-pointer transition-colors"
              >
                <X className="w-3.5 h-3.5" />
                <span>Deny / Request Review</span>
              </button>
              
              <button
                onClick={() => handleSignOffAction('approve')}
                disabled={signing}
                className="flex items-center gap-1.5 px-3.5 py-1.5 text-xs text-white bg-indigo-600 hover:bg-indigo-700 border border-indigo-600 rounded-lg font-semibold cursor-pointer transition-colors"
              >
                <Check className="w-3.5 h-3.5" />
                <span>Approve & Sign Off</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Faculty Submit Box (If draft status) */}
      {!evaluation.is_submitted && activeUser?.user_id === faculty.user_id && (
        <div className="bg-amber-50/70 border border-amber-200/70 rounded-xl p-5 shadow-card no-print flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div className="flex gap-3">
            <Lock className="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
            <div>
              <h3 className="font-display font-semibold text-sm text-slate-800">Submit appraisal sheet to department</h3>
              <p className="text-xs text-slate-500 mt-0.5">
                Once submitted, your logs are locked from further editing. The Head of Department (HoD) will be notified to review and sign-off on your academic workload hours and success metrics.
              </p>
            </div>
          </div>
          <button
            onClick={handleFacultySubmit}
            disabled={submitting}
            id="faculty-submit-btn"
            className="px-4 py-2 bg-amber-600 hover:bg-amber-700 disabled:bg-amber-400 text-xs text-white font-semibold rounded-lg shadow-sm cursor-pointer whitespace-nowrap transition-colors"
          >
            {submitting ? 'Submitting Appraisal...' : 'Submit Appraisal to HoD'}
          </button>
        </div>
      )}

      {/* 2. Top Controls Print bar */}
      <div className="flex items-center justify-between no-print bg-slate-50 p-3 rounded-lg border border-slate-100">
        <span className="text-xs font-mono text-slate-500">
          Evaluation Status: {' '}
          <strong className={`font-semibold shrink-0 uppercase px-2 py-0.5 rounded text-[10px] ${
            evaluation.principal_signed 
              ? 'bg-emerald-50 text-emerald-700' 
              : evaluation.is_submitted ? 'bg-amber-50 text-amber-700' : 'bg-slate-100 text-slate-600'
          }`}>
            {evaluation.principal_signed 
              ? 'Complete (Approved)' 
              : evaluation.is_submitted ? 'In Review (Submitted)' : 'Draft Mode'}
          </strong>
        </span>
        <button
          onClick={handlePrint}
          id="print-sheet-btn"
          className="flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white hover:bg-slate-100 border border-slate-200 rounded-lg cursor-pointer transition-colors"
        >
          <Printer className="w-4 h-4 text-slate-600" />
          <span>Print Evaluation Sheet</span>
        </button>
      </div>

      {/* 3. Master Print Document */}
      <div className="bg-white p-6 sm:p-10 rounded-xl border border-slate-100 shadow-card font-sans text-slate-800 space-y-8 print:p-0 print:border-none print:shadow-none">
        
        {/* Document Header Logo */}
        <div className="text-center border-b-2 border-slate-900 pb-5 space-y-1">
          <h2 className="font-display font-bold text-xl tracking-wide uppercase text-slate-900">
            Thangal Kunju Musaliar Institute of Technology, Kollam
          </h2>
          <p className="text-xs font-mono font-medium tracking-wide text-slate-500">
            KARIKODE, KOLLAM, KERALA | ACCREDITED BY NBA & NAAC
          </p>
          <h1 className="font-display font-extrabold text-base text-slate-900 tracking-wider uppercase pt-2">
            Faculty Performance Appraisal & Index Report (IDI)
          </h1>
          <p className="text-xs font-mono text-slate-500">Assessment Period: Academic Year 20{academicYear.year_string}</p>
        </div>

        {/* Profiles demographic section */}
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 bg-slate-50/50 p-4 rounded-lg border border-slate-100 text-xs">
          <div>
            <span className="font-mono text-[10px] uppercase text-slate-400 block tracking-wider">Faculty Member</span>
            <strong className="text-sm text-slate-900">{faculty.name}</strong>
          </div>
          <div>
            <span className="font-mono text-[10px] uppercase text-slate-400 block tracking-wider">Employee Code</span>
            <strong className="text-sm text-slate-900 font-mono">{faculty.user_id}</strong>
          </div>
          <div>
            <span className="font-mono text-[10px] uppercase text-slate-400 block tracking-wider">Designation / Grade</span>
            <strong className="text-sm text-slate-900">{faculty.designation}</strong>
          </div>
          <div>
            <span className="font-mono text-[10px] uppercase text-slate-400 block tracking-wider">Department</span>
            <strong className="text-sm text-slate-900">{faculty.department}</strong>
          </div>
        </div>

        {/* Real-time rating index summary card */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 bg-slate-900 text-white rounded-xl p-6 relative overflow-hidden">
          <div className="space-y-1">
            <span className="text-[10px] font-mono uppercase tracking-wider text-teal-400">GRAND SUMMARY INDEX</span>
            <div className="flex items-baseline gap-2">
              <span className="text-4xl font-display font-bold text-white">
                {calculatedScores.grandIndexScore.toFixed(2)}
              </span>
              <span className="text-sm text-slate-400 font-mono">/ 100.0</span>
            </div>
            <p className="text-[11px] text-slate-300 leading-snug">
              Annual aggregate score based on verified institutional frameworks.
            </p>
          </div>

          <div className="space-y-1 md:col-span-2 flex flex-col justify-between">
            <div>
              <span className="text-[10px] font-mono uppercase tracking-wider text-teal-400 block">INSTITUTIONAL PERFORMANCE LEVEL</span>
              <div className="flex items-center gap-2 mt-1">
                <span className={`text-xs font-bold font-display uppercase tracking-wider px-3 py-1 rounded-full border border-teal-500/30 bg-teal-500/10 text-teal-300`}>
                  {calculatedScores.finalIndexRating}
                </span>
              </div>
            </div>
            <div className="grid grid-cols-4 gap-2 pt-4 border-t border-slate-800 text-[11px] font-mono">
              <div className="text-center bg-slate-800/50 p-2 rounded">
                <div className="text-slate-400 text-[9px] mb-0.5">ACAD</div>
                <div className="font-bold text-slate-200">{calculatedScores.academicSubtotal.toFixed(1)}/40</div>
              </div>
              <div className="text-center bg-slate-800/50 p-2 rounded">
                <div className="text-slate-400 text-[9px] mb-0.5">RESR</div>
                <div className="font-bold text-slate-200">{calculatedScores.researchSubtotal.toFixed(1)}/30</div>
              </div>
              <div className="text-center bg-slate-800/50 p-2 rounded">
                <div className="text-slate-400 text-[9px] mb-0.5">ADMN</div>
                <div className="font-bold text-slate-200">{calculatedScores.adminSubtotal.toFixed(1)}/20</div>
              </div>
              <div className="text-center bg-slate-800/50 p-2 rounded">
                <div className="text-slate-400 text-[9px] mb-0.5">SOCI</div>
                <div className="font-bold text-slate-200">{calculatedScores.indSocSubtotal.toFixed(1)}/10</div>
              </div>
            </div>
          </div>
        </div>

        {/* Detailed Points Allocation Matrix */}
        <div className="space-y-4">
          <h3 className="font-display font-semibold text-sm text-slate-950 uppercase tracking-wider border-b-2 border-slate-900 pb-1.5">
            Component appraisal score sheet
          </h3>

          <div className="border border-slate-200 rounded-lg overflow-hidden text-xs">
            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="bg-slate-100 text-slate-700 font-mono text-[10px] tracking-wider border-b border-slate-200">
                  <th className="p-3 font-bold">METRIC / CATEGORY DESCRIPTION</th>
                  <th className="p-3 text-center w-36 font-bold">RAW PERFORMANCE LOG</th>
                  <th className="p-3 text-center w-32 font-bold">VERIFIED POINTS</th>
                  <th className="p-3 text-center w-28 font-bold">MAX VALUE</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-200 font-mono">
                
                {/* 1. Academics */}
                <tr className="bg-slate-50/50">
                  <td className="p-3 font-semibold" colSpan={3}>1. ACADEMIC ENGAGEMENT COLUMN (Max Subtotal: 40.0)</td>
                  <td className="p-3 text-center font-bold font-display text-slate-900 bg-slate-50">40.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Teaching Workload</div>
                    <div className="text-[10px] text-slate-400 font-normal">Lecture/Tutorial/Tutorial/Practicals (Hrs/week)</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {calculatedScores.totalWorkloadHours} hours
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.workloadScore.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">10.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Class Hours Engagement</div>
                    <div className="text-[10px] text-slate-400 font-normal">Mandatory vs Actually Engaged logs</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {academicMetrics.engaged_class_hours}/{academicMetrics.mandatory_class_hours} ({calculatedScores.classEngagementPct.toFixed(1)}%)
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.engagementScore.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">10.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Student Success Rate</div>
                    <div className="text-[10px] text-slate-400 font-normal">Passed / Total Attended Student Ratio</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {academicMetrics.students_passed}/{academicMetrics.students_attended} ({calculatedScores.passPct.toFixed(1)}%)
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.successRatePoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">6.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Student Feedback Score</div>
                    <div className="text-[10px] text-slate-400 font-normal">Feedback score logged by Students (1 to 5)</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {academicMetrics.student_feedback_score.toFixed(2)} rating
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.feedbackPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">5.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Workshops & Professional Development</div>
                    <div className="text-[10px] text-slate-400 font-normal">Attendance logs inside Seminars, FDP modules</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {academicMetrics.professional_development_points} points logged
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.profDevPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">9.0</td>
                </tr>

                {/* 2. Research & Consultancy */}
                <tr className="bg-slate-50/50 border-t border-slate-300">
                  <td className="p-3 font-semibold" colSpan={3}>2. RESEARCH & CONSULTANCY COLUMN (Max Subtotal: 30.0)</td>
                  <td className="p-3 text-center font-bold font-display text-slate-900 bg-slate-50">30.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Research Publications</div>
                    <div className="text-[10px] text-slate-400 font-normal">SCI / Scopus / Books / Chapters / Conference logs</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    SCI:{researchMetrics.pub_sci} | Scopus:{researchMetrics.pub_scopus} | Book:{researchMetrics.pub_book}
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.pubPoints.toFixed(1)} <span className="text-[9px] text-slate-400">+{calculatedScores.bonusPoints} bonus</span>
                  </td>
                  <td className="p-3 text-center text-slate-400">30.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Patents / Corporate IPR</div>
                    <div className="text-[10px] text-slate-400 font-normal">Designations of Granted / Filed Registry logs</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    Granted:{researchMetrics.patents_granted} | Pub:{researchMetrics.patents_published}
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.patentPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">30.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Research Project Funds</div>
                    <div className="text-[10px] text-slate-400 font-normal">Government & Non-Govt Granted / Applied grants</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    Granted: ₹{(researchMetrics.research_fund_granted_amt / 100000).toFixed(1)} L
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.researchFundPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">10.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Consultancy Operations</div>
                    <div className="text-[10px] text-slate-400 font-normal">Commercial consultancy generated values</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    ₹{researchMetrics.consultancy_amt.toLocaleString()} generated
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.consultancyPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">5.0</td>
                </tr>

                {/* 3. Administrative responsibilities */}
                <tr className="bg-slate-50/50 border-t border-slate-300">
                  <td className="p-3 font-semibold" colSpan={3}>3. ADMINISTRATIVE RESPONSIBILITIES (Max Subtotal: 20.0)</td>
                  <td className="p-3 text-center font-bold font-display text-slate-900 bg-slate-50">20.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Departmental Admin Commitments</div>
                    <div className="text-[10px] text-slate-400 font-normal">HoD, Advisor, Exam coordinator responsibilities selection</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {responsibilities.filter(r => r.type === 'Department').length} active role(s)
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.deptAdminPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">10.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Institutional Admin Commitments</div>
                    <div className="text-[10px] text-slate-400 font-normal">Deanship, IQAC, anti-ragging or ERP management references</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {responsibilities.filter(r => r.type === 'Institute').length} active role(s)
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.instAdminPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">10.0</td>
                </tr>

                {/* 4. Industrial and Societal */}
                <tr className="bg-slate-50/50 border-t border-slate-300">
                  <td className="p-3 font-semibold" colSpan={3}>4. INDUSTRIAL & SOCIETAL METRICS (Max Subtotal: 10.0)</td>
                  <td className="p-3 text-center font-bold font-display text-slate-900 bg-slate-50">10.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Startup & Entrepreneurial Log</div>
                    <div className="text-[10px] text-slate-400 font-normal">Active campus registration or guidance startup logs</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {industrySocietalMetrics.startup_score || 'No'} active
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.startupPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">5.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Industrial Training / Internship logs</div>
                    <div className="text-[10px] text-slate-400 font-normal">Placements, internships coordinating durations</div>
                  </td>
                  <td className="p-3 text-center text-slate-600">
                    {industrySocietalMetrics.industrial_training_days + industrySocietalMetrics.internship_days + industrySocietalMetrics.industrial_visit_days} days total
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.industrialTrainingPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">5.0</td>
                </tr>
                <tr>
                  <td className="p-3 pl-6">
                    <div className="font-sans font-semibold text-xs text-slate-800">Community Outreach voluntary programs</div>
                    <div className="text-[10px] text-slate-400 font-normal">Societal contribution ratings (NSS, technology sharing)</div>
                  </td>
                  <td className="p-3 text-center text-slate-600 truncate max-w-xs">
                    {industrySocietalMetrics.societal_activity_desc || 'No details log'}
                  </td>
                  <td className="p-3 text-center font-semibold text-slate-800">
                    {calculatedScores.societalPoints.toFixed(1)}
                  </td>
                  <td className="p-3 text-center text-slate-400">5.0</td>
                </tr>

                {/* Final calculated total row */}
                <tr className="bg-slate-900 text-white font-display text-sm font-bold border-t-2 border-slate-900 uppercase">
                  <td className="p-3" colSpan={2}>GRAND ACCRUED ASSESSMENT INDEX (IDI)</td>
                  <td className="p-3 text-center text-emerald-400 text-base">{calculatedScores.grandIndexScore.toFixed(2)}</td>
                  <td className="p-3 text-center text-slate-300">100.0</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        {/* Official comment lines & approval flow signatures */}
        <div className="space-y-6 pt-5 border-t border-slate-200">
          <h3 className="font-display font-semibold text-xs uppercase tracking-wider text-slate-900 border-b pb-1.5">
            Institutional Auditing & Comments Logs
          </h3>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs leading-relaxed">
            {/* HoD box */}
            <div className="bg-slate-50 p-4 rounded-lg border border-slate-200/60 relative">
              <span className="font-mono text-[9px] uppercase tracking-wider text-slate-400 block border-b pb-1 mb-2">
                1. DEPARTMENT SIGN-OFF (HOD)
              </span>
              <p className="min-h-[40px] text-slate-600 italic">
                {evaluation.hod_comments ? `"${evaluation.hod_comments}"` : 'No comments logged.'}
              </p>
              <div className="mt-4 border-t border-dashed border-slate-300 pt-2 flex items-center justify-between font-mono text-[10px]">
                <span>Status:</span>
                <span className={evaluation.hod_signed ? 'text-emerald-700 font-bold' : 'text-amber-600'}>
                  {evaluation.hod_signed ? `Approved (on ${evaluation.hod_signed_date})` : 'Awaiting Review'}
                </span>
              </div>
            </div>

            {/* Dean box */}
            <div className="bg-slate-50 p-4 rounded-lg border border-slate-200/60 relative">
              <span className="font-mono text-[9px] uppercase tracking-wider text-slate-400 block border-b pb-1 mb-2">
                2. ACADEMIC VERIFICATION (DEAN)
              </span>
              <p className="min-h-[40px] text-slate-600 italic">
                {evaluation.dean_comments ? `"${evaluation.dean_comments}"` : 'No comments logged.'}
              </p>
              <div className="mt-4 border-t border-dashed border-slate-300 pt-2 flex items-center justify-between font-mono text-[10px]">
                <span>Status:</span>
                <span className={evaluation.dean_signed ? 'text-emerald-700 font-bold' : 'text-amber-600'}>
                  {evaluation.dean_signed ? `Approved (on ${evaluation.dean_signed_date})` : 'Awaiting Review'}
                </span>
              </div>
            </div>

            {/* Principal box */}
            <div className="bg-slate-50 p-4 rounded-lg border border-slate-200/60 relative">
              <span className="font-mono text-[9px] uppercase tracking-wider text-slate-400 block border-b pb-1 mb-2">
                3. EXECUTIVE SIGNATURE (PRINCIPAL)
              </span>
              <p className="min-h-[40px] text-slate-600 italic">
                {evaluation.principal_comments ? `"${evaluation.principal_comments}"` : 'No comments logged.'}
              </p>
              <div className="mt-4 border-t border-dashed border-slate-300 pt-2 flex items-center justify-between font-mono text-[10px]">
                <span>Status:</span>
                <span className={evaluation.principal_signed ? 'text-emerald-700 font-bold' : 'text-amber-600'}>
                  {evaluation.principal_signed ? `Approved (on ${evaluation.principal_signed_date})` : 'Awaiting Review'}
                </span>
              </div>
            </div>
          </div>

          {/* Signature Lines Block */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-8 pt-12 text-center text-xs font-mono font-semibold">
            <div className="space-y-4">
              <div className="border-t border-slate-900 pt-1.5">{faculty.name}</div>
              <div className="text-[10px] text-slate-400 font-normal">Candidate Faculty</div>
            </div>

            <div className="space-y-4">
              <div className="border-t border-slate-950 pt-1.5">
                {evaluation.hod_signed ? '✓ VERIFIED SIGNATURE' : '─────────────────'}
              </div>
              <div className="text-[10px] text-slate-400 font-normal">Head of Department</div>
            </div>

            <div className="space-y-4">
              <div className="border-t border-slate-950 pt-1.5">
                {evaluation.dean_signed ? '✓ AUDITED SIGNATURE' : '─────────────────'}
              </div>
              <div className="text-[10px] text-slate-400 font-normal">Dean (Academic)</div>
            </div>

            <div className="space-y-4">
              <div className="border-t border-slate-950 pt-1.5">
                {evaluation.principal_signed ? '✓ PRINCIPAL EXECUTIVE' : '─────────────────'}
              </div>
              <div className="text-[10px] text-slate-400 font-normal">Principal & Director</div>
            </div>
          </div>

        </div>

      </div>

    </div>
  );
};
